# ==============================================================================
# Perception API - Environment Variables
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/perception?retryWrites=true&w=majority"

# Security & Authentication
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720  # no refresh tokens, so keep web sessions to a working day

# Groq LLM API Key (Sign up at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Agentic grading pipeline (all optional; defaults shown)
GRADING_PIPELINE="graph"            # or "legacy" for the original single-call grader
GRADER_MODEL="openai/gpt-oss-120b"
CRITIC_MODEL="openai/gpt-oss-120b"
GATEKEEPER_MODEL="llama-3.1-8b-instant"
CONFIDENCE_THRESHOLD=0.85
PASS_MARK=5.0
MAX_TOOL_ROUNDS=3

# Google OAuth Client ID (Optional: for Google sign-in)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"


# ==============================================================================
# Perception API - Environment Variables
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/perception?retryWrites=true&w=majority"

# Security & Authentication
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq LLM API Key (Sign up at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Google OAuth Client ID (Optional: for Google sign-in)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

